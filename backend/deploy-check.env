# Production-like settings for `just check-deploy` (and CI): Django's deploy checks must pass
# behind a TLS proxy without warnings. Not secret; never used to run the app.
DEBUG=false
APP_URLS=https://argus.example.com
BEHIND_PROXY=true
SECRET_KEY=deploy-check-not-secret-but-long-and-random-enough-0123456789abcdef
