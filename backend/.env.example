# Copy to .env and adjust. All values are optional in development.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Berlin

# Frontend origins for split deployments (not needed with the Vite dev proxy)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Database (defaults to SQLite). Example for PostgreSQL (requires `uv add "psycopg[binary]"`):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=argus
# DB_USER=argus
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432
