{
  // Argus development tasks. Run via "Terminal → Run Task…" (Ctrl+Shift+P → Tasks: Run Task).
  "version": "2.0.0",
  "tasks": [
    // --- Development servers -------------------------------------------------
    {
      "label": "Dev: start all",
      "detail": "Backend and frontend dev servers side by side",
      "dependsOn": ["Dev: backend", "Dev: frontend"],
      "problemMatcher": []
    },
    {
      "label": "Dev: backend",
      "detail": "Django runserver on :8000",
      "type": "shell",
      "command": "uv run python manage.py runserver 127.0.0.1:8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Dev: frontend",
      "detail": "Vite dev server on :5173 (proxies /api and /admin to :8000)",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Dev: docs",
      "detail": "Documentation (VitePress) on :5175/docs/",
      "type": "shell",
      "command": "pnpm dev --port 5175",
      "options": { "cwd": "${workspaceFolder}/docs" },
      "isBackground": true,
      "problemMatcher": []
    },

    // --- Setup ---------------------------------------------------------------
    {
      "label": "Setup: install dependencies",
      "detail": "uv sync + pnpm install",
      "dependsOn": ["Setup: backend dependencies", "Setup: frontend dependencies", "Setup: docs dependencies"],
      "problemMatcher": []
    },
    {
      "label": "Setup: backend dependencies",
      "type": "shell",
      "command": "uv sync",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Setup: frontend dependencies",
      "type": "shell",
      "command": "pnpm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Setup: docs dependencies",
      "type": "shell",
      "command": "pnpm install",
      "options": { "cwd": "${workspaceFolder}/docs" },
      "problemMatcher": []
    },

    // --- Database ------------------------------------------------------------
    {
      "label": "DB: migrate",
      "type": "shell",
      "command": "uv run python manage.py migrate",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "DB: make migrations",
      "type": "shell",
      "command": "uv run python manage.py makemigrations --no-header",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "DB: seed demo data",
      "detail": "Demo users (password argus-demo), devices and requests",
      "type": "shell",
      "command": "uv run python manage.py seed_demo",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "DB: reset and seed (deletes all data!)",
      "type": "shell",
      "command": "uv run python manage.py flush --no-input && uv run python manage.py seed_demo",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "DB: create superuser",
      "type": "shell",
      "command": "uv run python manage.py createsuperuser",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },

    {
      "label": "DB: start dev postgres",
      "detail": "PostgreSQL on 127.0.0.1:5432 (compose.dev.yml); then run the backend with DB_HOST=localhost",
      "type": "shell",
      "command": "docker compose -f compose.dev.yml up -d",
      "problemMatcher": []
    },

    {
      "label": "API: update types",
      "detail": "After API changes: export openapi.json from Django, generate frontend/src/api/schema.d.ts; commit both",
      "type": "shell",
      "command": "uv run python manage.py export_openapi ../frontend/openapi.json && cd ../frontend && pnpm api:types",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },

    // --- Quality -------------------------------------------------------------
    {
      "label": "Check: all",
      "detail": "Everything CI runs for backend, frontend and docs (reports only, fixes nothing)",
      "dependsOn": ["Check: backend", "Check: deploy settings", "Check: frontend", "Check: docs"],
      "dependsOrder": "sequence",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Check: backend",
      "detail": "Same as the CI backend job: ruff, mypy, deptry, migrations, system checks, tests with coverage",
      "type": "shell",
      "command": "uv run ruff check . && uv run ruff format --check . && uv run mypy . && uv run deptry . && uv run python manage.py makemigrations --check --dry-run && uv run python manage.py check && uv run pytest -q --cov",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Check: deploy settings",
      "detail": "Same as the CI step: manage.py check --deploy with production settings behind a TLS proxy",
      "type": "shell",
      "command": "uv run python manage.py check --deploy --fail-level WARNING",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "DEBUG": "false",
          "SECRET_KEY": "ci-deploy-check-not-secret-but-long-and-random-enough-0123456789abcdef",
          "APP_URLS": "https://argus.example.com",
          "BEHIND_PROXY": "true"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Check: frontend",
      "detail": "Same as the CI frontend job: oxlint, eslint, knip, prettier, type-check, tests with coverage, licenses, bundle size",
      "type": "shell",
      "command": "pnpm lint && pnpm format:check && pnpm type-check && pnpm test:coverage && pnpm check:licenses && pnpm build-only && pnpm size",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Check: docs",
      "detail": "Same as the CI docs job: build the documentation (fails on dead links, anchors and IT links in the employee areas)",
      "type": "shell",
      "command": "pnpm build",
      "options": { "cwd": "${workspaceFolder}/docs" },
      "problemMatcher": []
    },
    {
      "label": "Test: backend",
      "type": "shell",
      "command": "uv run pytest",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Lint: backend",
      "detail": "ruff format + ruff check --fix",
      "type": "shell",
      "command": "uv run ruff format . && uv run ruff check --fix .",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Test: frontend",
      "type": "shell",
      "command": "pnpm test:unit --run",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Check: frontend types",
      "type": "shell",
      "command": "pnpm type-check",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Lint: frontend",
      "detail": "prettier + oxlint + eslint (with --fix)",
      "type": "shell",
      "command": "pnpm format && pnpm lint:fix",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": ["$eslint-stylish"]
    },

    // --- Translations --------------------------------------------------------
    {
      "label": "i18n: update backend messages",
      "detail": "makemessages for German, then edit backend/locale/de/LC_MESSAGES/django.po",
      "type": "shell",
      "command": "uv run python manage.py makemessages -l de --ignore '.venv/*' --no-wrap",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "i18n: compile backend messages",
      "type": "shell",
      "command": "uv run python manage.py compilemessages",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },

    // --- Docker --------------------------------------------------------------
    {
      "label": "Docker: build and start",
      "detail": "docker compose up --build -d (uses .env)",
      "type": "shell",
      "command": "docker compose up --build -d",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Docker: backup now",
      "detail": "Dump the database into the backups volume (see README, Backups)",
      "type": "shell",
      "command": "docker compose exec backup sh /backup.sh now",
      "problemMatcher": []
    },
    {
      "label": "Docker: stop",
      "type": "shell",
      "command": "docker compose down",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Docker: logs",
      "type": "shell",
      "command": "docker compose logs -f app",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docker: Django shell",
      "type": "shell",
      "command": "docker compose exec app python manage.py shell",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
