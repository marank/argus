{
  // Argus development tasks. Run via "Terminal → Run Task…" (Ctrl+Shift+P → Tasks: Run Task).
  // Each one calls a recipe of the justfile, where the commands live (CI calls the same ones).
  "version": "2.0.0",
  "tasks": [
    // --- Development servers -------------------------------------------------
    {
      "label": "Dev: start all",
      "detail": "Backend and frontend dev servers side by side",
      "dependsOn": ["Dev: backend", "Dev: frontend"],
      "problemMatcher": []
    },
    {
      "label": "Dev: backend",
      "detail": "Django runserver on :8000",
      "type": "shell",
      "command": "just dev-backend",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Dev: frontend",
      "detail": "Vite dev server on :5173 (proxies /api and /admin to :8000)",
      "type": "shell",
      "command": "just dev-frontend",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Dev: docs",
      "detail": "Documentation (VitePress) on :5175/docs/",
      "type": "shell",
      "command": "just dev-docs",
      "isBackground": true,
      "problemMatcher": []
    },

    // --- Setup ---------------------------------------------------------------
    {
      "label": "Setup: install dependencies",
      "detail": "uv sync + pnpm install (frontend and docs)",
      "type": "shell",
      "command": "just setup",
      "problemMatcher": []
    },

    // --- Database ------------------------------------------------------------
    {
      "label": "DB: migrate",
      "type": "shell",
      "command": "just migrate",
      "problemMatcher": []
    },
    {
      "label": "DB: make migrations",
      "type": "shell",
      "command": "just migrations",
      "problemMatcher": []
    },
    {
      "label": "DB: seed demo data",
      "detail": "Demo users (password argus-demo), devices and requests",
      "type": "shell",
      "command": "just seed",
      "problemMatcher": []
    },
    {
      "label": "DB: reset and seed (deletes all data!)",
      "type": "shell",
      "command": "just --yes reset",
      "problemMatcher": []
    },
    {
      "label": "DB: create superuser",
      "type": "shell",
      "command": "just superuser",
      "problemMatcher": []
    },
    {
      "label": "DB: start dev postgres",
      "detail": "PostgreSQL on 127.0.0.1:5432 (compose.dev.yml); then run the backend with DB_HOST=localhost",
      "type": "shell",
      "command": "just db-up",
      "problemMatcher": []
    },

    {
      "label": "API: update types",
      "detail": "After API changes: export openapi.json from Django, generate frontend/src/api/schema.d.ts; commit both",
      "type": "shell",
      "command": "just api-types",
      "problemMatcher": []
    },

    // --- Quality -------------------------------------------------------------
    {
      "label": "Check: all",
      "detail": "Everything CI runs: backend, deploy settings, frontend, docs, workflows (reports only, fixes nothing)",
      "type": "shell",
      "command": "just check",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Check: backend",
      "detail": "ruff, mypy, deptry, import layers, licenses, migrations, system checks, translations, OpenAPI, tests",
      "type": "shell",
      "command": "just check-backend",
      "problemMatcher": []
    },
    {
      "label": "Check: deploy settings",
      "detail": "manage.py check --deploy with production settings behind a TLS proxy",
      "type": "shell",
      "command": "just check-deploy",
      "problemMatcher": []
    },
    {
      "label": "Check: frontend",
      "detail": "prettier, oxlint, eslint, knip, types, tests with coverage, API types, licenses, bundle size",
      "type": "shell",
      "command": "just check-frontend",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Check: docs",
      "detail": "Build the documentation (fails on dead links, anchors and IT links in the employee areas)",
      "type": "shell",
      "command": "just check-docs",
      "problemMatcher": []
    },
    {
      "label": "Check: workflows",
      "detail": "GitHub workflows: actionlint and zizmor",
      "type": "shell",
      "command": "just check-workflows",
      "problemMatcher": []
    },
    {
      "label": "Test: backend",
      "type": "shell",
      "command": "just test-backend",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Test: frontend",
      "type": "shell",
      "command": "just test-frontend",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Lint: backend",
      "detail": "ruff format + ruff check --fix",
      "type": "shell",
      "command": "just fix-backend",
      "problemMatcher": []
    },
    {
      "label": "Lint: frontend",
      "detail": "prettier + oxlint + eslint (with --fix)",
      "type": "shell",
      "command": "just fix-frontend",
      "problemMatcher": ["$eslint-stylish"]
    },

    // --- Translations --------------------------------------------------------
    {
      "label": "i18n: update backend messages",
      "detail": "makemessages for German (needs gettext), then edit backend/locale/de/LC_MESSAGES/django.po",
      "type": "shell",
      "command": "just messages",
      "problemMatcher": []
    },
    {
      "label": "i18n: compile backend messages",
      "detail": "django.po -> django.mo (needs gettext); commit both",
      "type": "shell",
      "command": "just compile-messages",
      "problemMatcher": []
    },

    // --- Docker --------------------------------------------------------------
    {
      "label": "Docker: build and start",
      "detail": "Build the image argus:latest and run it with docker compose up -d (uses .env)",
      "type": "shell",
      "command": "just docker-up",
      "problemMatcher": []
    },
    {
      "label": "Docker: backup now",
      "detail": "Dump the database into the backups volume (see docs/en/it/operations/backups.md)",
      "type": "shell",
      "command": "just docker-backup",
      "problemMatcher": []
    },
    {
      "label": "Docker: stop",
      "type": "shell",
      "command": "just docker-down",
      "problemMatcher": []
    },
    {
      "label": "Docker: logs",
      "type": "shell",
      "command": "just docker-logs",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docker: Django shell",
      "type": "shell",
      "command": "docker compose exec app python manage.py shell",
      "problemMatcher": []
    }
  ]
}
