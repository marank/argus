{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "backend",
        "python",
        "manage.py",
        "runserver",
        "127.0.0.1:8010"
      ],
      "port": 8010
    },
    {
      "name": "backend-postgres",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DB_HOST=localhost",
        "uv",
        "run",
        "--directory",
        "backend",
        "python",
        "manage.py",
        "runserver",
        "127.0.0.1:8010"
      ],
      "port": 8010
    },
    {
      "name": "frontend",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "BACKEND_URL=http://127.0.0.1:8010",
        "pnpm",
        "--dir",
        "frontend",
        "dev",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "frontend-windows",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set BACKEND_URL=http://127.0.0.1:8010&& pnpm --dir frontend dev --port 5174 --strictPort"
      ],
      "port": 5174
    }
  ]
}
