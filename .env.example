# Argus configuration for docker compose. Copy to .env (project root) and adjust:
#   cp .env.example .env
# Never commit .env; it holds secrets.

# --- Application ----------------------------------------------------------------
# Image to run. Default: the published ghcr.io/marank/argus:latest (current main).
# For an image built from this repository (docker build -t argus:latest .):
# ARGUS_IMAGE=argus:latest
# Every URL users open Argus under, comma separated (scheme, host and port if not
# default). Allowed hosts, CSRF origins and secure cookies are derived from it;
# use https URLs only once a TLS proxy is in front.
APP_URLS=http://localhost:8080
# Port published on the host.
APP_PORT=8080
# Gunicorn worker processes; empty = 2 × CPU + 1 (max 5).
APP_WORKERS=
# Fill an EMPTY database with demo data (users with password "argus-demo"). Not for production.
APP_DEMO_DATA=false

# Address(es) of a TLS proxy in front of Argus (comma separated IPs or CIDR ranges).
# Only from these nginx accepts X-Forwarded-For/-Proto, i.e. the client's address and
# HTTPS. Required with https URLs in APP_URLS. Empty: clients connect directly.
TRUSTED_PROXIES=

# Long random string (at least 40 characters; Argus refuses to start otherwise).
# Generate it with:
#   openssl rand -hex 32
SECRET_KEY=change-me
TIME_ZONE=Europe/Berlin
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Development only (API docs, detailed errors); never in production. Debug is on only
# with DEBUG=true; the justfile sets it for local development.
# DEBUG=false
# Set to true in the image: Django takes the scheme from nginx in front of it.
# BEHIND_PROXY=true

# --- First administrator (created on first start if the user does not exist) ----
# Made an administrator again on every start; whether it is active stays as set in the app.
ADMIN_USERNAME=admin
ADMIN_EMAIL=it@example.com
# Only used when the user is created; change it later with
#   docker compose exec app python manage.py set_password admin
ADMIN_PASSWORD=change-me

# --- Database (PostgreSQL container) ---------------------------------------------
POSTGRES_DB=argus
POSTGRES_USER=argus
# Only used between the containers; a random value is best: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
# PostgreSQL server: compose.yml sets DB_HOST=db. Without DB_HOST (native development)
# Argus uses a local SQLite file; `DB_HOST=localhost` uses compose.dev.yml's database.
# DB_HOST=db
# DB_PORT=5432

# --- Backups ----------------------------------------------------------------------
# The app dumps the database daily at this time (HH:MM in TIME_ZONE) into the
# "db-backups" volume; dumps older than BACKUP_KEEP_DAYS days are deleted. See
# docs/en/it/operations/backups.md. BACKUP_DIR (default /backups in the image) empty
# switches it off.
BACKUP_TIME=01:30
BACKUP_KEEP_DAYS=14
# BACKUP_DIR=/backups

# --- LDAP / Active Directory login (optional) -------------------------------------
# Can also be configured in the app (Administration → LDAP login, superusers only).
# Every variable that is set (non-empty) wins over the in-app value and is shown
# read-only there; leave a variable out or empty to manage the value in the app.
# LDAP_ENABLED=true
# LDAP_SERVER_URI=ldaps://dc1.example.com,ldaps://dc2.example.com
# LDAP_START_TLS=false
# LDAP_VERIFY_CERT=true
# LDAP_CA_CERT_FILE=/app/certs/ca.pem
# LDAP_TIMEOUT=5
# LDAP_BIND_DN=CN=svc-argus,OU=Service,DC=example,DC=com
# LDAP_BIND_PASSWORD=change-me
# LDAP_USER_SEARCH_BASE=OU=Staff,DC=example,DC=com
# LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
# LDAP_CREATE_USERS=true
# Attribute mapping (LDAP attribute per Argus field):
# LDAP_ATTR_USERNAME=sAMAccountName
# LDAP_ATTR_FIRST_NAME=givenName
# LDAP_ATTR_LAST_NAME=sn
# LDAP_ATTR_EMPLOYEE_NUMBER=employeeID
# LDAP_ATTR_EMAIL=mail
# LDAP_ATTR_JOB_TITLE=title
# LDAP_ATTR_PHONE=telephoneNumber
