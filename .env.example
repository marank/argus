# Argus configuration for docker compose. Copy to .env (project root) and adjust:
#   cp .env.example .env
# Never commit .env; it holds secrets.

# --- Application ----------------------------------------------------------------
# Every URL users open Argus under, comma separated (scheme, host and port if not
# default). Allowed hosts, CSRF/CORS origins and secure cookies are derived from it;
# use https URLs only once a TLS proxy is in front.
APP_URLS=http://localhost:8080
# Port published on the host.
APP_PORT=8080
# Gunicorn worker processes; empty = 2 × CPU + 1 (max 5).
APP_WORKERS=
# Fill an EMPTY database with demo data (users with password "argus-demo"). Not for production.
APP_DEMO_DATA=false

# Long random string, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
TIME_ZONE=Europe/Berlin
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- First administrator (created on first start if the user does not exist) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=it@example.com
ADMIN_PASSWORD=change-me

# --- Database (PostgreSQL container) ---------------------------------------------
POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=change-me

# --- LDAP / Active Directory login (optional) -------------------------------------
# Can also be configured in the app (Administration → LDAP login, superusers only).
# Every variable that is set (non-empty) wins over the in-app value and is shown
# read-only there; leave a variable out or empty to manage the value in the app.
# LDAP_ENABLED=true
# LDAP_SERVER_URI=ldaps://dc1.example.com,ldaps://dc2.example.com
# LDAP_START_TLS=false
# LDAP_VERIFY_CERT=true
# LDAP_CA_CERT_FILE=/app/certs/ca.pem
# LDAP_TIMEOUT=5
# LDAP_BIND_DN=CN=svc-argus,OU=Service,DC=example,DC=com
# LDAP_BIND_PASSWORD=change-me
# LDAP_USER_SEARCH_BASE=OU=Staff,DC=example,DC=com
# LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
# LDAP_CREATE_USERS=true
# Attribute mapping (LDAP attribute per Argus field):
# LDAP_ATTR_USERNAME=sAMAccountName
# LDAP_ATTR_FIRST_NAME=givenName
# LDAP_ATTR_LAST_NAME=sn
# LDAP_ATTR_EMPLOYEE_NUMBER=employeeID
# LDAP_ATTR_EMAIL=mail
# LDAP_ATTR_JOB_TITLE=title
# LDAP_ATTR_PHONE=telephoneNumber
