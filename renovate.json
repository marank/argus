{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":semanticCommits"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "pre-commit": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "customManagers": [
    {
      "description": "Versions pinned in the Dockerfile with a `# renovate:` comment (supervisor from PyPI)",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\S+_VERSION=(?<currentValue>\\S+)"]
    },
    {
      "description": "Images started with `docker run` inside workflow steps (Trivy scan)",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["(?<depName>aquasec/trivy):(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Non-major updates in one PR per side",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["!pnpm"],
      "groupName": "frontend (non-major)"
    },
    {
      "description": "Documentation (docs/) in its own PR",
      "matchManagers": ["npm"],
      "matchFileNames": ["docs/**"],
      "matchPackageNames": ["!pnpm"],
      "groupName": "docs"
    },
    {
      "description": "Non-major updates in one PR per side",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["!django"],
      "groupName": "backend (non-major)"
    },
    {
      "description": "Hook revisions in .pre-commit-config.yaml (ruff there follows ruff in pyproject.toml)",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "pnpm comes from `packageManager` via corepack, in CI and in the Dockerfile; its own PR",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm"
    },
    {
      "description": "Base and CI images in one PR (Node, Python, uv, Trivy)",
      "matchManagers": ["dockerfile", "docker-compose", "github-actions", "custom.regex"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "images (non-major)"
    },
    {
      "description": "Python minor upgrades (3.14 -> 3.15) need wheels of all dependencies and the CI image (uv:python3.x-...) updated by hand; only after approval on the dashboard",
      "matchPackageNames": ["python"],
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major", "minor"],
      "groupName": "python",
      "dependencyDashboardApproval": true
    },
    {
      "description": "TypeScript 7 is the native compiler; vue-tsc builds on the JavaScript API of TypeScript 6. Only after approval on the dashboard",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "PostgreSQL major upgrades need a dump/restore of the data; CI stays on the major of compose.yml",
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Django feature releases (6.1 -> 6.2) in their own PR, only after approval on the dashboard; read the release notes first",
      "matchPackageNames": ["django"],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    }
  ]
}
