{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.mjs"],
  "project": ["src/**/*.{ts,vue}", "scripts/*.mjs"],
  // Types and constants a module uses itself may be exported for later use.
  "ignoreExportsUsedInFile": true,
  // Generated by openapi-typescript (pnpm api:types); only `components` is used.
  "ignore": ["src/api/schema.d.ts"],
  // Imported from CSS (src/assets/styles/base.css), which knip does not read.
  "ignoreDependencies": ["@fontsource-variable/ibm-plex-sans", "@fontsource-variable/jetbrains-mono"]
}
