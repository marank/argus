{
  "name": "argus-frontend",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint . && eslint . --cache && knip",
    "lint:fix": "oxlint . --fix && eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "format:check": "prettier --check --experimental-cli src/",
    "check": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test:coverage && pnpm check:duplication",
    "check:duplication": "jscpd --config .jscpd.json",
    "check:licenses": "node scripts/check-licenses.mjs",
    "size": "size-limit",
    "api:types": "openapi-typescript openapi.json -o src/api/schema.d.ts && prettier --write --experimental-cli src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fullcalendar/vue3": "7.1.5",
    "@lucide/vue": "^1.73.0",
    "@vueuse/core": "^15.0.0",
    "naive-ui": "^2.45.3",
    "pinia": "^4.0.3",
    "temporal-polyfill": "^1.0.8",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@size-limit/file": "^14.3.0",
    "@tsconfig/node24": "^24.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.93.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-vue": "~10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "jiti": "^2.7.0",
    "jscpd": "^5.4.3",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "npm-run-all2": "^9.0.4",
    "openapi-typescript": "^7.13.0",
    "oxlint": "~1.93.0",
    "prettier": "3.10.1",
    "size-limit": "^14.3.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.8",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@12.14.0",
  "size-limit": [
    {
      "name": "JS",
      "path": "dist/assets/*.js",
      "limit": "730 kB"
    },
    {
      "name": "CSS",
      "path": "dist/assets/*.css",
      "limit": "42 kB"
    }
  ]
}
